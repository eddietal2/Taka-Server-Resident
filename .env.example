# ---------------------------------------------------------------------------
# Copy to .env.local for local development. Never commit real secrets.
# In Vercel, set these per environment (Development / Preview / Production).
# ---------------------------------------------------------------------------

# Runtime + Node server
NODE_ENV=development
PORT=3000

# Neon Postgres
# DATABASE_URL must be the POOLED connection string (host contains "-pooler").
# DIRECT_URL must be the DIRECT connection string, used only by prisma migrate.
DATABASE_URL=postgresql://neondb_owner:npg_m4MBbT8gLeGW@ep-morning-heart-b2jda8qx-pooler.c-6.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://neondb_owner:npg_m4MBbT8gLeGW@ep-morning-heart-b2jda8qx.c-6.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Tokens (use long random strings, 32+ chars)
JWT_SECRET=1nErh2AHQqhkvkc00tugrOXkcKfvh9im5ScUKjJJx29HEjJbi5CO8s28pPlqrISI
VERIFICATION_TOKEN_TTL_SECONDS=900
ACCESS_TOKEN_TTL_SECONDS=2592000

# OTP
# Provider: "africastalking" sends SMS, "log" only writes the code to the server log.
# Switch to "africastalking" once AT_API_KEY below is filled in.
OTP_PROVIDER=africastalking

# Africa's Talking
# Sandbox uses the literal username "sandbox" with a sandbox API key. It does not
# deliver real SMS; add your test numbers in the AT dashboard first.
# Production: set AT_USERNAME to your AT account username and switch the endpoint
# host to api.africastalking.com.
AT_USERNAME=sandbox
AT_API_KEY=atsk_ab203845045c358df24a7123bd7174e9d4919ac9f3f96bc0cd03738fec34c194c62191ac
# Optional. Empty uses the AT shared shortcode; set an approved sender ID for production.
AT_SENDER_ID=
AT_SMS_ENDPOINT=https://api.sandbox.africastalking.com/version1/messaging
AT_TIMEOUT_MS=10000

# OTP hashing and lifetime. Rotate OTP_SECRET before going live.
OTP_SECRET=9f2c7b4e6a1d8053c9e2f7b4a6d1083e5c7a9b2d4f6081c3e5a7b9d1f3042c68
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
# Challenges older than this are pruned on each request. 0 disables pruning.
OTP_RETENTION_SECONDS=86400

# Dev/Preview only: echoes dev_code and accepts OTP_DEV_CODE. Forbidden in production.
OTP_DEV_MODE=true
OTP_DEV_CODE=000000

# When false, register-* returns no token and status PENDING.
REGISTRATION_AUTO_APPROVE=true

# Cloudflare R2 (S3-compatible). Leave blank to disable uploads locally.
R2_ACCOUNT_ID=a4133677366de3c1141797ca04c8a8b3
R2_ACCESS_KEY_ID=76680561de275ba188742e2d4cc6f41c
R2_SECRET_ACCESS_KEY=c9f299a7ab29d97fc3649e9141d6c74b36a910fff0b770984becd9fe9c627a79
R2_BUCKET=taka-resident-app
# Public base URL or custom domain, no trailing slash.
R2_PUBLIC_BASE_URL=https://pub-f40d3f2acace482dbca23a2ac09e193d.r2.dev
R2_PRESIGN_TTL_SECONDS=300

# Comma-separated origins for the Expo *web* build only. Native iOS/Android builds
# send no Origin header and are not subject to CORS, so nothing is needed there.
# Empty allows all (dev only; set explicit origins before shipping web).
CORS_ORIGINS=
