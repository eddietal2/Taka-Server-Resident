// Taka resident server — Neon Postgres via Prisma.
// Runtime uses the pooled DATABASE_URL; migrations use DIRECT_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Intent {
  RESIDENT
  REPORTER
  COMMERCIAL
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model User {
  id         String     @id @default(cuid())
  phone      String     @unique
  intent     Intent
  status     UserStatus @default(ACTIVE)
  firstName  String?
  lastName   String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  resident   ResidentProfile?
  reporter   ReporterProfile?
  commercial CommercialProfile?
}

model ResidentProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wardKata          String
  streetMtaa        String
  lukuMeter         String   @unique
  unitNumber        String?
  latitude          Float
  longitude         Float
  profilePictureUrl String
  createdAt         DateTime @default(now())
}

model ReporterProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profilePictureUrl String
  createdAt         DateTime @default(now())
}

model CommercialProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName    String
  wardKata        String
  streetMtaa      String
  latitude        Float
  longitude       Float
  // Provisional: the app currently only sends HIGH_VOLUME_DAILY. Stored as a
  // string so the tier list can grow without a migration.
  wasteTier       String
  taxId           String   @unique
  businessLogoUrl String
  // Optional: a business may register without a meter, but when it has one we
  // keep the reference so collections can be matched to the premises. Unique so
  // the database, not just the meter step, refuses a second account on one
  // meter; Postgres treats NULLs as distinct, so meterless businesses are
  // unaffected.
  lukuMeter       String?  @unique
  createdAt       DateTime @default(now())
}

/// A confirmed LUKU meter, created the first time a resident looks one up.
///
/// The meter reference number is the durable key (`meterNumber`): the sign-up
/// flow resolves the owner once, then pins GPS coordinates to the same record
/// on the location step so a later sign-up for the same meter starts from the
/// address already on file. `phone` records who first claimed it; the profile
/// tables own the authoritative user link once registration completes.
model Luku {
  id          String   @id @default(cuid())
  meterNumber String   @unique
  phone       String?
  /// Registered owner as returned by the utility; null when unconfirmed.
  ownerName   String?
  wardKata    String?
  streetMtaa  String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phone])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}
